<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.media-catalog-server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/media-catalog-server</string>
    <string>--data-root</string>
    <string>/Users/andi/.media-catalog/data</string>
    <string>--media-root</string>
    <string>/Volumes/media/photos</string>
    <string>--bind</string>
    <string>127.0.0.1:8080</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>MEDIA_CATALOG_TOKEN</key>
    <string>replace-with-a-long-random-value</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/media-catalog-server.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/media-catalog-server.log</string>
</dict>
</plist>

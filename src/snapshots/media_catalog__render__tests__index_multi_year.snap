<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Media catalog</title>
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">Media catalog</a>
    <nav><a href="/search.html">Search</a></nav>
  </header>
  <main>
    
    <h1>Years</h1>
    
    <ul class="year-list">
      
      <li>
        <a href="/2024/">
          <span class="year">2024</span>
          <span class="count">1 items</span>
        </a>
      </li>
      
      <li>
        <a href="/2023/">
          <span class="year">2023</span>
          <span class="count">1 items</span>
        </a>
      </li>
      
    </ul>
    
    
    <h1>Recent</h1>
    
    
    <div class="grid recent-grid">
  
  <figure class="tile">
    <a class="tile-link" href="/media/2024/05/b.jpg"
      data-item-path="2024/05/b.jpg"
      data-kind="image"
      data-captured="2024-05-01 10:00:00"
      data-size="0"
      data-thumb-url="/thumbs/2024/05/b.jpg.webp?v=10-20"
      data-width="4000"
      data-height="3000">
      
      <img src="/thumbs/2024/05/b.jpg.webp?v=10-20" alt="b.jpg" loading="lazy" decoding="async">
      
      
      <figcaption><time>24-05-01 10:00</time></figcaption>
    </a>
  </figure>
  
  <figure class="tile">
    <a class="tile-link" href="/media/2023/12/a.jpg"
      data-item-path="2023/12/a.jpg"
      data-kind="image"
      data-captured="2023-12-01 10:00:00"
      data-size="0"
      data-thumb-url="/thumbs/2023/12/a.jpg.webp?v=10-20"
      data-width="4000"
      data-height="3000">
      
      <img src="/thumbs/2023/12/a.jpg.webp?v=10-20" alt="a.jpg" loading="lazy" decoding="async">
      
      
      <figcaption><time>23-12-01 10:00</time></figcaption>
    </a>
  </figure>
  
</div>
    
    <p class="total">2 items in the catalog</p>
  </main>
  <footer><p>Generated by media-catalog.</p></footer>
  <script src="/assets/viewer.js" defer></script>
</body>
</html>
